<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels.HR"
             x:Class="ErpSystem.Desktop.Views.HR.HrEmployeesWorkspaceView"
             x:Name="Root"
             x:DataType="vm:HrEmployeesWorkspaceViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://ErpSystem.Desktop/Views/HR/HrWorkspaceStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="HR" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Kadry operacyjne" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Kartoteki pracowników z przypisaniem do działu, stanowiska i profilu kierowcy." MaxWidth="300" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="16">
            <Border Classes="panel" Padding="14" CornerRadius="18">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <TextBox Width="340" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po numerze, nazwie lub emailu..." Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                        <ComboBox Width="220" Margin="0,0,10,10" ItemsSource="{Binding DepartmentFilterOptions}" SelectedItem="{Binding SelectedDepartmentFilter}" />
                        <CheckBox Margin="0,0,18,10" VerticalAlignment="Center" IsChecked="{Binding ShowInactive}" Content="Pokaż nieaktywnych" />
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunEmployeeActionCommand}" CommandParameter="New" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Nowy pracownik" Foreground="{DynamicResource AccentBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunEmployeeActionCommand}" CommandParameter="Save" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Zapisz" Foreground="{DynamicResource AccentBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunEmployeeActionCommand}" CommandParameter="Toggle" IsEnabled="{Binding HasSelectedEmployee}" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Aktywuj / wyłącz" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunEmployeeActionCommand}" CommandParameter="Delete" IsEnabled="{Binding HasSelectedEmployee}" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Usuń" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="255" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14" Padding="16" MinHeight="126" CornerRadius="18" Classes="panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="1.45*,1.05*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Kartoteka pracowników" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="Lista osób z działem, stanowiskiem i bazą do obsługi urlopów, dokumentów oraz umów." TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding VisibleEmployees.Count, StringFormat='Pracowników: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="1050" RowDefinitions="Auto,*">
                            <Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="120,190,220,150,160,110,100">
                                    <TextBlock Text="Numer" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1" Text="Pracownik" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="2" Text="Email" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="3" Text="Dział" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="4" Text="Stanowisko" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="6" Text="Kierowca" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleEmployees}" SelectedItem="{Binding SelectedEmployee}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.SelectEmployeeCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <Border Margin="0,0,0,8" Padding="12,12" HorizontalAlignment="Stretch" CornerRadius="14" Classes="table-row" BorderThickness="1">
                                                <Grid ColumnDefinitions="120,190,220,150,160,110,100">
                                                    <TextBlock Text="{Binding EmployeeNumber}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Email}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding DepartmentName}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding PositionName}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <Border Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,4" CornerRadius="999" Background="{Binding StatusColor}">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                    <TextBlock Grid.Column="6" Text="{Binding DriverLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SelectedEmployeeTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="{Binding SelectedEmployeeDepartment}" Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBlock Text="{Binding SelectedEmployeePosition}" Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <StackPanel Spacing="6"><TextBlock Text="Numer" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorEmployeeNumber}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Email" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorEmail}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="Imię" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorFirstName}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6"><TextBlock Text="Nazwisko" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorLastName}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="2" Spacing="6"><TextBlock Text="Telefon" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorPhoneNumber}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6"><TextBlock Text="PESEL / ID" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorPersonalId}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="3" Spacing="6"><TextBlock Text="Dział" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding DepartmentOptions}" SelectedItem="{Binding SelectedDepartment}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6"><TextBlock Text="Stanowisko" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding PositionOptions}" SelectedItem="{Binding SelectedPosition}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Grid.Row="4" Spacing="6"><TextBlock Text="Typ umowy" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding ContractTypeOptions}" SelectedItem="{Binding SelectedContractType}" /></StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
                                <CheckBox IsChecked="{Binding EditorIsActive}" Content="Pracownik aktywny" />
                                <CheckBox IsChecked="{Binding EditorHasDriverProfile}" Content="Profil kierowcy" />
                            </StackPanel>
                        </Grid>

                        <Border Classes="soft-card" Padding="14" CornerRadius="16">
                            <TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
