<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels.HR"
             x:Class="ErpSystem.Desktop.Views.HR.HrLeaveRequestsWorkspaceView"
             x:Name="Root"
             x:DataType="vm:HrLeaveRequestsWorkspaceViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://ErpSystem.Desktop/Views/HR/HrWorkspaceStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="HR" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Nieobecności" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Wnioski urlopowe i nieobecności pracowników z terminami oraz statusem." MaxWidth="300" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="16">
            <Border Classes="panel" Padding="14" CornerRadius="18">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <TextBox Width="340" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po pracowniku lub typie urlopu..." Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                        <ComboBox Width="210" Margin="0,0,10,10" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" />
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunLeaveRequestActionCommand}" CommandParameter="New" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Nowy wniosek" Foreground="{DynamicResource AccentBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunLeaveRequestActionCommand}" CommandParameter="Save" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Zapisz" Foreground="{DynamicResource AccentBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunLeaveRequestActionCommand}" CommandParameter="Cancel" IsEnabled="{Binding HasSelectedRequest}" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Anuluj" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="255" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14" Padding="16" MinHeight="126" CornerRadius="18" Classes="panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="1.45*,1.05*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Wnioski urlopowe" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding VisibleRequests.Count, StringFormat='Wniosków: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="980" RowDefinitions="Auto,*">
                            <Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="170,160,150,90,120,1.1*">
                                    <TextBlock Text="Pracownik" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1" Text="Typ urlopu" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="2" Text="Termin" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="3" Text="Dni" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="5" Text="Powód / decyzja" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleRequests}" SelectedItem="{Binding SelectedRequest}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.SelectLeaveRequestCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <Border Margin="0,0,0,8" Padding="12,12" HorizontalAlignment="Stretch" CornerRadius="14" Classes="table-row" BorderThickness="1">
                                                <Grid ColumnDefinitions="170,160,150,90,120,1.1*">
                                                    <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LeaveTypeName}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PeriodLabel}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding DayCountLabel}" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,4" CornerRadius="999" Background="{Binding StatusColor}"><TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border>
                                                    <StackPanel Grid.Column="5" Spacing="2"><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" /><TextBlock Text="{Binding DecisionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22">
                <StackPanel Spacing="16">
                    <TextBlock Text="Edycja wniosku" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto">
                        <StackPanel Spacing="6"><TextBlock Text="Pracownik" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding EmployeeOptions}" SelectedItem="{Binding SelectedEmployee}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Typ urlopu" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding LeaveTypeOptions}" SelectedItem="{Binding SelectedLeaveType}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                        <StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="Data od" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDateFrom}" Watermark="dd.MM.rrrr" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6"><TextBlock Text="Data do" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDateTo}" Watermark="dd.MM.rrrr" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                        <StackPanel Grid.Row="2" Spacing="6"><TextBlock Text="Liczba dni" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDayCount}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="6"><TextBlock Text="Powód" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorReason}" MinHeight="92" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                    </Grid>
                    <Border Classes="soft-card" Padding="14" CornerRadius="16"><TextBlock Text="{Binding SelectedDecisionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" /></Border>
                    <Border Classes="soft-card" Padding="14" CornerRadius="16"><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" /></Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
