<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels.HR"
             x:Class="ErpSystem.Desktop.Views.HR.HrDepartmentsWorkspaceView"
             x:Name="Root"
             x:DataType="vm:HrDepartmentsWorkspaceViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://ErpSystem.Desktop/Views/HR/HrWorkspaceStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="HR" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Struktura firmy" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Działy wspólne dla kadr, kosztów i procesów transportowych." MaxWidth="280" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="16">
            <Border Classes="panel" Padding="14" CornerRadius="18">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <TextBox Width="340" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po kodzie lub nazwie działu..." Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                        <CheckBox Margin="0,0,18,10" VerticalAlignment="Center" IsChecked="{Binding ShowInactive}" Content="Pokaż nieaktywne" />
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunDepartmentActionCommand}" CommandParameter="New" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Nowy dział" Foreground="{DynamicResource AccentBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunDepartmentActionCommand}" CommandParameter="Save" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Zapisz" Foreground="{DynamicResource AccentBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunDepartmentActionCommand}" CommandParameter="Toggle" IsEnabled="{Binding HasSelectedDepartment}" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Aktywuj / wyłącz" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunDepartmentActionCommand}" CommandParameter="Delete" IsEnabled="{Binding HasSelectedDepartment}" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Usuń" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="255" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14" Padding="16" MinHeight="126" CornerRadius="18" Classes="panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="1.35*,1.15*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Lista działów" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding VisibleDepartments.Count, StringFormat='Działów: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="860" RowDefinitions="Auto,*">
                            <Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="120,220,1.2*,120,120">
                                    <TextBlock Text="Kod" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1" Text="Nazwa" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="2" Text="Opis" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="4" Text="Pracownicy" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleDepartments}" SelectedItem="{Binding SelectedDepartment}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.SelectDepartmentCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <Border Margin="0,0,0,8" Padding="12,12" HorizontalAlignment="Stretch" CornerRadius="14" Classes="table-row" BorderThickness="1">
                                                <Grid ColumnDefinitions="120,220,1.2*,120,120">
                                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,4" CornerRadius="999" Background="{Binding StatusColor}"><TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border>
                                                    <TextBlock Grid.Column="4" Text="{Binding EmployeeCount}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22">
                <StackPanel Spacing="16">
                    <TextBlock Text="Edycja działu" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Text="Kod" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding EditorCode}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                        <TextBlock Grid.Row="1" Text="Nazwa" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditorName}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                        <TextBlock Grid.Row="2" Text="Opis" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditorDescription}" MinHeight="88" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding EditorIsActive}" Content="Dział aktywny" />
                    </Grid>
                    <Border Classes="soft-card" Padding="14" CornerRadius="16"><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" /></Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
