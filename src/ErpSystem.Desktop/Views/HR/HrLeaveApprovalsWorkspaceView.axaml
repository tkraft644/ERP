<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels.HR"
             x:Class="ErpSystem.Desktop.Views.HR.HrLeaveApprovalsWorkspaceView"
             x:Name="Root"
             x:DataType="vm:HrLeaveApprovalsWorkspaceViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://ErpSystem.Desktop/Views/HR/HrWorkspaceStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="HR" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Kolejka decyzji" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Podejmuj decyzje urlopowe i kontroluj wpływ nieobecności na dział." MaxWidth="300" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="16">
            <Border Classes="panel" Padding="14" CornerRadius="18">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <TextBox Width="340" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po pracowniku lub typie urlopu..." Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                        <ComboBox Width="180" Margin="0,0,10,10" ItemsSource="{Binding QueueFilterOptions}" SelectedItem="{Binding SelectedQueueFilter}" />
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunApprovalActionCommand}" CommandParameter="Approve" IsEnabled="{Binding HasSelectedApproval}" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Zatwierdź" Foreground="{DynamicResource AccentBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunApprovalActionCommand}" CommandParameter="Reject" IsEnabled="{Binding HasSelectedApproval}" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Odrzuć" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunApprovalActionCommand}" CommandParameter="Cancel" IsEnabled="{Binding HasSelectedApproval}" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Anuluj" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunApprovalActionCommand}" CommandParameter="Clear" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Wyczyść notatkę" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="255" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14" Padding="16" MinHeight="126" CornerRadius="18" Classes="panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="1.45*,1.05*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Kolejka akceptacji" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding VisibleApprovals.Count, StringFormat='Pozycji: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="1040" RowDefinitions="Auto,*">
                            <Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="170,140,150,150,90,120,1.1*">
                                    <TextBlock Text="Pracownik" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1" Text="Dział" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="2" Text="Typ urlopu" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="3" Text="Termin" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="4" Text="Dni" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="6" Text="Powód / decyzja" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleApprovals}" SelectedItem="{Binding SelectedApproval}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.SelectApprovalCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <Border Margin="0,0,0,8" Padding="12,12" HorizontalAlignment="Stretch" CornerRadius="14" Classes="table-row" BorderThickness="1">
                                                <Grid ColumnDefinitions="170,140,150,150,90,120,1.1*">
                                                    <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DepartmentName}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding LeaveTypeName}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding PeriodLabel}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding DayCountLabel}" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <Border Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,4" CornerRadius="999" Background="{Binding StatusColor}"><TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border>
                                                    <StackPanel Grid.Column="6" Spacing="2"><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" /><TextBlock Text="{Binding DecisionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22">
                <StackPanel Spacing="16">
                    <TextBlock Text="Decyzja urlopowa" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Decydujący" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding DecisionBy}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                        <TextBlock Grid.Row="1" Text="Notatka" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DecisionNote}" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                    </Grid>
                    <Border Classes="soft-card" Padding="14" CornerRadius="16"><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" /></Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
