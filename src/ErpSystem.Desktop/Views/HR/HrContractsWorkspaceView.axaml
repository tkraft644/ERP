<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels.HR"
             x:Class="ErpSystem.Desktop.Views.HR.HrContractsWorkspaceView"
             x:Name="Root"
             x:DataType="vm:HrContractsWorkspaceViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://ErpSystem.Desktop/Views/HR/HrWorkspaceStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="HR" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Historia zatrudnienia" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Umowy z działem, stanowiskiem, kosztem i podstawą zatrudnienia." MaxWidth="300" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="16">
            <Border Classes="panel" Padding="14" CornerRadius="18">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal">
                        <TextBox Width="320" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po numerze umowy lub pracowniku..." Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                        <ComboBox Width="210" Margin="0,0,10,10" ItemsSource="{Binding DepartmentFilterOptions}" SelectedItem="{Binding SelectedDepartmentFilter}" />
                        <ComboBox Width="180" Margin="0,0,10,10" ItemsSource="{Binding ContractTypeFilterOptions}" SelectedItem="{Binding SelectedContractTypeFilter}" />
                        <CheckBox Margin="0,0,18,10" VerticalAlignment="Center" IsChecked="{Binding ShowArchived}" Content="Pokaż archiwum" />
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunContractActionCommand}" CommandParameter="New" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Nowa umowa" Foreground="{DynamicResource AccentBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunContractActionCommand}" CommandParameter="Save" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Zapisz" Foreground="{DynamicResource AccentBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunContractActionCommand}" CommandParameter="Archive" IsEnabled="{Binding HasSelectedContract}" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Archiwizuj" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                        <Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunContractActionCommand}" CommandParameter="Delete" IsEnabled="{Binding HasSelectedContract}" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><TextBlock Text="Usuń" Foreground="{DynamicResource ForegroundBrush}" /></Button>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="255" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14" Padding="16" MinHeight="126" CornerRadius="18" Classes="panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="1.45*,1.05*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Lista umów" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding VisibleContracts.Count, StringFormat='Umów: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="1180" RowDefinitions="Auto,*">
                            <Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="150,170,140,160,110,130,90,120,110">
                                    <TextBlock Text="Numer umowy" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1" Text="Pracownik" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="2" Text="Dział" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="3" Text="Stanowisko" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="4" Text="Typ" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="5" Text="Okres" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="6" Text="Etatu" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="7" Text="Pensja" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="8" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" />
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleContracts}" SelectedItem="{Binding SelectedContract}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.SelectContractCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <Border Margin="0,0,0,8" Padding="12,12" HorizontalAlignment="Stretch" CornerRadius="14" Classes="table-row" BorderThickness="1">
                                                <Grid ColumnDefinitions="150,170,140,160,110,130,90,120,110">
                                                    <TextBlock Text="{Binding ContractNumber}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding EmployeeName}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DepartmentName}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding PositionName}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding ContractType}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding PeriodLabel}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="6" Text="{Binding EmploymentRateLabel}" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="7" Text="{Binding SalaryLabel}" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <Border Grid.Column="8" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,4" CornerRadius="999" Background="{Binding StatusColor}"><TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Edycja umowy" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <StackPanel Spacing="6"><TextBlock Text="Pracownik" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding EmployeeOptions}" SelectedItem="{Binding SelectedEmployee}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Numer umowy" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorContractNumber}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="Dział" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding DepartmentOptions}" SelectedItem="{Binding SelectedDepartment}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6"><TextBlock Text="Stanowisko" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding PositionOptions}" SelectedItem="{Binding SelectedPosition}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Grid.Row="2" Spacing="6"><TextBlock Text="Typ umowy" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding ContractTypeOptions}" SelectedItem="{Binding SelectedContractType}" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6"><TextBlock Text="Wymiar etatu" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorEmploymentRate}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="3" Spacing="6"><TextBlock Text="Start" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorStartDate}" Watermark="dd.MM.rrrr" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6"><TextBlock Text="Koniec" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorEndDate}" Watermark="dd.MM.rrrr" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="4" Spacing="6"><TextBlock Text="Pensja miesięczna" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorMonthlySalary}" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="8" VerticalAlignment="Bottom"><CheckBox IsChecked="{Binding EditorIsActive}" Content="Umowa aktywna" /></StackPanel>
                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Spacing="6"><TextBlock Text="Notatki" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorNotes}" MinHeight="92" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" /></StackPanel>
                        </Grid>
                        <Border Classes="soft-card" Padding="14" CornerRadius="16"><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" /></Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
