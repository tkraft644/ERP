<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels.System"
             x:Class="ErpSystem.Desktop.Views.System.SystemRolesWorkspaceView"
             x:Name="Root"
             x:DataType="vm:SystemRolesWorkspaceViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://ErpSystem.Desktop/Views/System/SystemWorkspaceStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="System"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Subtitle}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,9"
                    CornerRadius="14"
                    Background="{DynamicResource AccentSurfaceBrush}"
                    VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Macierz dostępu"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Buduj role dla modułów i od razu kontroluj ich permissiony oraz użytkowników."
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Spacing="16">
            <Border Classes="panel"
                    Padding="14"
                    CornerRadius="18">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal"
                               >
                        <TextBox Width="340"
                                 Margin="0,0,10,10"
                                 Text="{Binding SearchText}"
                                 Watermark="Szukaj po kodzie lub nazwie roli..."
                                 Padding="12,10"
                                 Background="{DynamicResource SubtleSurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" />
                        <CheckBox Margin="0,0,18,10"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding ShowInactive}"
                                  Content="Pokaż nieaktywne" />
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunRoleActionCommand}"
                                CommandParameter="New"
                                Background="{DynamicResource AccentSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Nowa rola"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunRoleActionCommand}"
                                CommandParameter="Save"
                                Background="{DynamicResource AccentSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Zapisz"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunRoleActionCommand}"
                                CommandParameter="Delete"
                                IsEnabled="{Binding HasSelectedRole}"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Usuń"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Button>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemWidth="255" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14"
                                Padding="16"
                                MinHeight="126"
                                CornerRadius="18"
                                Classes="panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding Value}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Caption}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2"
              ColumnDefinitions="1.35*,1.15*"
              ColumnSpacing="18">
            <Border Classes="panel"
                    Padding="18"
                    CornerRadius="22">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Role systemowe i niestandardowe"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="Zarządzaj kodem, opisem, statusem i wykorzystaniem ról w całym systemie."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding VisibleRoles.Count, StringFormat='Ról: {0}'}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="980"
                              RowDefinitions="Auto,*">
                            <Border Padding="12,10"
                                    CornerRadius="14"
                                    Background="{DynamicResource TableHeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="120,210,1.2*,110,110,110,110">
                                    <TextBlock Text="Kod"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="Rola"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="Opis"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="3"
                                               Text="Status"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="4"
                                               Text="Użytkownicy"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="5"
                                               Text="Permissiony"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="6"
                                               Text="Typ"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     ItemsSource="{Binding VisibleRoles}"
                                     SelectedItem="{Binding SelectedRole}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SelectRoleCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <Border Margin="0,0,0,8"
                                                    Padding="12,12"
                                                    HorizontalAlignment="Stretch"
                                                    CornerRadius="14"
                                                    Classes="table-row"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="120,210,1.2*,110,110,110,110">
                                                    <TextBlock Text="{Binding Code}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Description}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <Border Grid.Column="3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Padding="9,4"
                                                            CornerRadius="999"
                                                            Background="{Binding StatusColor}">
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White" />
                                                    </Border>
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding UserCount}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding PermissionCount}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="6"
                                                               Text="{Binding TypeLabel}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="panel"
                    Padding="18"
                    CornerRadius="22">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SelectedRoleTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="{Binding SelectedRoleUsersLabel}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="150,*"
                              ColumnSpacing="12"
                              RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Text="Kod"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding EditorCode}"
                                     Watermark="np. WAREHOUSE_SUPERVISOR"
                                     Padding="12,10"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                            <TextBlock Grid.Row="1"
                                       Text="Nazwa"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding EditorName}"
                                     Watermark="Nazwa roli"
                                     Padding="12,10"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                            <TextBlock Grid.Row="2"
                                       Text="Opis"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding EditorDescription}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="88"
                                     Padding="12,10"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                            <CheckBox Grid.Row="3"
                                      Grid.Column="1"
                                      IsChecked="{Binding EditorIsActive}"
                                      Content="Rola aktywna" />
                        </Grid>

                        <Border Classes="soft-card"
                                Padding="14"
                                CornerRadius="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Nadaj permission"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="10">
                                    <ComboBox ItemsSource="{Binding ModuleFilterOptions}"
                                              SelectedItem="{Binding SelectedPermissionModuleFilter}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding PermissionSearchText}"
                                             Watermark="Szukaj permissionu..."
                                             Padding="12,10"
                                             Background="{DynamicResource SubtleSurfaceBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <ComboBox ItemsSource="{Binding PermissionsToAssign}"
                                              SelectedItem="{Binding SelectedPermissionToAssign}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1"
                                            Padding="12,10"
                                            Command="{Binding RunRoleActionCommand}"
                                            CommandParameter="AddPermission"
                                            IsEnabled="{Binding HasSelectedRole}"
                                            Background="{DynamicResource AccentSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TextBlock Text="Nadaj"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="soft-card"
                                Padding="14"
                                CornerRadius="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding AssignedPermissions.Count, StringFormat='Przypisane permissiony: {0}'}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <ItemsControl ItemsSource="{Binding AssignedPermissions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                                        <TextBlock Text="{Binding Module}"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Padding="10,6"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemovePermissionCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10">
                                                        <TextBlock Text="Odbierz"
                                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="soft-card"
                                Padding="14"
                                CornerRadius="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding RoleUsers.Count, StringFormat='Użytkownicy w roli: {0}'}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <ItemsControl ItemsSource="{Binding RoleUsers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Text="{Binding Email}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="soft-card"
                                Padding="14"
                                CornerRadius="16">
                            <TextBlock Text="{Binding LastActionMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
