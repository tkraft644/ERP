<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels.System"
             x:Class="ErpSystem.Desktop.Views.System.SystemDictionariesWorkspaceView"
             x:Name="Root"
             x:DataType="vm:SystemDictionariesWorkspaceViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://ErpSystem.Desktop/Views/System/SystemWorkspaceStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="System"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Subtitle}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,9"
                    CornerRadius="14"
                    Background="{DynamicResource AccentSurfaceBrush}"
                    VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Dane referencyjne"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Utrzymuj waluty, typy, kody i inne słowniki współdzielone przez moduły systemu."
                               MaxWidth="320"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Spacing="16">
            <Border Classes="panel"
                    Padding="14"
                    CornerRadius="18">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal"
                               >
                        <TextBox Width="340"
                                 Margin="0,0,10,10"
                                 Text="{Binding SearchText}"
                                 Watermark="Szukaj po kodzie, wartości lub opisie..."
                                 Padding="12,10"
                                 Background="{DynamicResource SubtleSurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" />
                        <ComboBox Width="210"
                                  Margin="0,0,10,10"
                                  ItemsSource="{Binding AreaFilterOptions}"
                                  SelectedItem="{Binding SelectedAreaFilter}" />
                        <ComboBox Width="220"
                                  Margin="0,0,10,10"
                                  ItemsSource="{Binding CategoryFilterOptions}"
                                  SelectedItem="{Binding SelectedCategoryFilter}" />
                        <CheckBox Margin="0,0,18,10"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding ShowArchived}"
                                  Content="Pokaż archiwum" />
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunDictionaryActionCommand}"
                                CommandParameter="New"
                                Background="{DynamicResource AccentSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Nowy wpis"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunDictionaryActionCommand}"
                                CommandParameter="Save"
                                Background="{DynamicResource AccentSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Zapisz"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunDictionaryActionCommand}"
                                CommandParameter="Archive"
                                IsEnabled="{Binding HasSelectedItem}"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Archiwizuj"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Button>
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunDictionaryActionCommand}"
                                CommandParameter="Restore"
                                IsEnabled="{Binding HasSelectedItem}"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Przywróć"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Button>
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunDictionaryActionCommand}"
                                CommandParameter="Delete"
                                IsEnabled="{Binding HasSelectedItem}"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Usuń"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Button>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemWidth="255" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14"
                                Padding="16"
                                MinHeight="126"
                                CornerRadius="18"
                                Classes="panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding Value}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Caption}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2"
              ColumnDefinitions="1.4*,1.1*"
              ColumnSpacing="18">
            <Border Classes="panel"
                    Padding="18"
                    CornerRadius="22">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Wpisy słownikowe"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="Centralna lista wartości referencyjnych używanych przez transport, magazyn, HR i finanse."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding VisibleItems.Count, StringFormat='Wpisów: {0}'}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="960"
                              RowDefinitions="Auto,*">
                            <Border Padding="12,10"
                                    CornerRadius="14"
                                    Background="{DynamicResource TableHeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="140,170,120,1.2*,110,110">
                                    <TextBlock Text="Obszar"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="Kategoria"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="Kod"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="3"
                                               Text="Wartość"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="4"
                                               Text="Status"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="5"
                                               Text="Archiwum"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     ItemsSource="{Binding VisibleItems}"
                                     SelectedItem="{Binding SelectedItem}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SelectDictionaryCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <Border Margin="0,0,0,8"
                                                    Padding="12,12"
                                                    HorizontalAlignment="Stretch"
                                                    CornerRadius="14"
                                                    Classes="table-row"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="140,170,120,1.2*,110,110">
                                                    <TextBlock Text="{Binding Area}"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Category}"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Code}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <StackPanel Grid.Column="3"
                                                                Spacing="2">
                                                        <TextBlock Text="{Binding Value}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding StatusLabel}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding ArchiveLabel}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="panel"
                    Padding="18"
                    CornerRadius="22">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Edycja wpisu słownikowego"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" />

                        <Grid ColumnDefinitions="140,*"
                              ColumnSpacing="12"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Text="Obszar"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding EditorArea}"
                                     Watermark="np. Transport"
                                     Padding="12,10"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                            <TextBlock Grid.Row="1"
                                       Text="Kategoria"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding EditorCategory}"
                                     Watermark="np. Incoterms"
                                     Padding="12,10"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                            <TextBlock Grid.Row="2"
                                       Text="Kod"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding EditorCode}"
                                     Watermark="Kod słownika"
                                     Padding="12,10"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                            <TextBlock Grid.Row="3"
                                       Text="Wartość"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Text="{Binding EditorValue}"
                                     Watermark="Wartość biznesowa"
                                     Padding="12,10"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                            <TextBlock Grid.Row="4"
                                       Text="Opis"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Text="{Binding EditorDescription}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="96"
                                     Padding="12,10"
                                     Background="{DynamicResource SubtleSurfaceBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                            <CheckBox Grid.Row="5"
                                      Grid.Column="1"
                                      IsChecked="{Binding EditorIsActive}"
                                      Content="Wpis aktywny" />
                        </Grid>

                        <Border Classes="soft-card"
                                Padding="14"
                                CornerRadius="16">
                            <TextBlock Text="{Binding LastActionMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
