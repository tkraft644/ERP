<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels.System"
             x:Class="ErpSystem.Desktop.Views.System.SystemAuditWorkspaceView"
             x:Name="Root"
             x:DataType="vm:SystemAuditWorkspaceViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://ErpSystem.Desktop/Views/System/SystemWorkspaceStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="System"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Subtitle}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,9"
                    CornerRadius="14"
                    Background="{DynamicResource AccentSurfaceBrush}"
                    VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Historia zmian"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Przeglądaj operacje administracyjne, filtrowane po module, encji i rodzaju akcji."
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Spacing="16">
            <Border Classes="panel"
                    Padding="14"
                    CornerRadius="18">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal"
                               >
                        <TextBox Width="360"
                                 Margin="0,0,10,10"
                                 Text="{Binding SearchText}"
                                 Watermark="Szukaj po użytkowniku, encji lub szczegółach..."
                                 Padding="12,10"
                                 Background="{DynamicResource SubtleSurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" />
                        <ComboBox Width="220"
                                  Margin="0,0,10,10"
                                  ItemsSource="{Binding ModuleFilterOptions}"
                                  SelectedItem="{Binding SelectedModuleFilter}" />
                        <ComboBox Width="220"
                                  Margin="0,0,10,10"
                                  ItemsSource="{Binding ActionFilterOptions}"
                                  SelectedItem="{Binding SelectedActionFilter}" />
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunAuditActionCommand}"
                                CommandParameter="Clear"
                                Background="{DynamicResource AccentSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Wyczyść filtry"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunAuditActionCommand}"
                                CommandParameter="Refresh"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Odśwież"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Button>
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunAuditActionCommand}"
                                CommandParameter="Export"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Eksportuj"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Button>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemWidth="255" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14"
                                Padding="16"
                                MinHeight="126"
                                CornerRadius="18"
                                Classes="panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding Value}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Caption}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2"
              ColumnDefinitions="1.4*,1.1*"
              ColumnSpacing="18">
            <Border Classes="panel"
                    Padding="18"
                    CornerRadius="22">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Log audytu"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="Lista operacji zarejestrowanych podczas pracy administratorów i użytkowników systemu."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding VisibleEntries.Count, StringFormat='Wpisów: {0}'}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="980"
                              RowDefinitions="Auto,*">
                            <Border Padding="12,10"
                                    CornerRadius="14"
                                    Background="{DynamicResource TableHeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="150,170,120,120,120,1.1*">
                                    <TextBlock Text="Czas"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="Użytkownik"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="Moduł"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="3"
                                               Text="Encja"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="4"
                                               Text="Akcja"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="5"
                                               Text="Szczegóły"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     ItemsSource="{Binding VisibleEntries}"
                                     SelectedItem="{Binding SelectedEntry}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SelectAuditCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <Border Margin="0,0,0,8"
                                                    Padding="12,12"
                                                    HorizontalAlignment="Stretch"
                                                    CornerRadius="14"
                                                    Classes="table-row"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="150,170,120,120,120,1.1*">
                                                    <TextBlock Text="{Binding At, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding User}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Module}"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Entity}"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding Action}"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding Detail}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="panel"
                    Padding="18"
                    CornerRadius="22">
                <StackPanel Spacing="16">
                    <TextBlock Text="Szczegóły wpisu"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />

                    <Grid ColumnDefinitions="150,*"
                          ColumnSpacing="12"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Text="Czas"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedAuditTime}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Grid.Row="1"
                                   Text="Użytkownik"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding SelectedAuditUser}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Grid.Row="2"
                                   Text="Moduł"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding SelectedAuditModule}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Grid.Row="3"
                                   Text="Encja"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding SelectedAuditEntity}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Grid.Row="4"
                                   Text="Akcja"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Text="{Binding SelectedAuditAction}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Grid.Row="5"
                                   Text="Szczegóły"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Grid.Row="5"
                                   Grid.Column="1"
                                   Text="{Binding SelectedAuditDetail}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                    </Grid>

                    <Border Classes="soft-card"
                            Padding="14"
                            CornerRadius="16">
                        <TextBlock Text="{Binding LastActionMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
