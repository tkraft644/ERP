<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels.System"
             x:Class="ErpSystem.Desktop.Views.System.SystemPermissionsWorkspaceView"
             x:Name="Root"
             x:DataType="vm:SystemPermissionsWorkspaceViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://ErpSystem.Desktop/Views/System/SystemWorkspaceStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="System"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Subtitle}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,9"
                    CornerRadius="14"
                    Background="{DynamicResource AccentSurfaceBrush}"
                    VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Akcje i zasoby"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Kontroluj permissiony na poziomie akcji i sprawdzaj, które role naprawdę ich używają."
                               MaxWidth="320"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Spacing="16">
            <Border Classes="panel"
                    Padding="14"
                    CornerRadius="18">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <WrapPanel Orientation="Horizontal"
                               >
                        <TextBox Width="340"
                                 Margin="0,0,10,10"
                                 Text="{Binding SearchText}"
                                 Watermark="Szukaj po nazwie, zasobie lub akcji..."
                                 Padding="12,10"
                                 Background="{DynamicResource SubtleSurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" />
                        <ComboBox Width="210"
                                  Margin="0,0,10,10"
                                  ItemsSource="{Binding ModuleFilterOptions}"
                                  SelectedItem="{Binding SelectedModuleFilter}" />
                        <ComboBox Width="220"
                                  Margin="0,0,10,10"
                                  ItemsSource="{Binding ResourceFilterOptions}"
                                  SelectedItem="{Binding SelectedResourceFilter}" />
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunPermissionActionCommand}"
                                CommandParameter="Refresh"
                                Background="{DynamicResource AccentSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Odśwież"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Margin="0,0,10,10"
                                Padding="12,10"
                                Command="{Binding RunPermissionActionCommand}"
                                CommandParameter="Export"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBlock Text="Eksportuj"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Button>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemWidth="255" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,14"
                                Padding="16"
                                MinHeight="126"
                                CornerRadius="18"
                                Classes="panel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                                <TextBlock Text="{Binding Value}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentColor}" />
                                <TextBlock Text="{Binding Caption}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2"
              ColumnDefinitions="1.42*,1.08*"
              ColumnSpacing="18">
            <Border Classes="panel"
                    Padding="18"
                    CornerRadius="22">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Katalog permissionów"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="Akcje systemowe i modułowe z informacją, ile ról ma do nich dostęp."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding VisiblePermissions.Count, StringFormat='Permissionów: {0}'}"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid MinWidth="980"
                              RowDefinitions="Auto,*">
                            <Border Padding="12,10"
                                    CornerRadius="14"
                                    Background="{DynamicResource TableHeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="1.35*,120,160,110,120">
                                    <TextBlock Text="Permission"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="Moduł"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="Zasób"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="3"
                                               Text="Akcja"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Grid.Column="4"
                                               Text="Role"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     Margin="0,12,0,0"
                                     ItemsSource="{Binding VisiblePermissions}"
                                     SelectedItem="{Binding SelectedPermission}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SelectPermissionCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <Border Margin="0,0,0,8"
                                                    Padding="12,12"
                                                    HorizontalAlignment="Stretch"
                                                    CornerRadius="14"
                                                    Classes="table-row"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="1.35*,120,160,110,120">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Module}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Resource}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Action}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding AssignedRolesCount}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ForegroundBrush}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="panel"
                    Padding="18"
                    CornerRadius="22">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SelectedPermissionTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="{Binding SelectedPermissionDescription}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <Border Classes="soft-card"
                                    Padding="14"
                                    CornerRadius="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Moduł"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Text="{Binding SelectedPermissionModule}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Classes="soft-card"
                                    Padding="14"
                                    CornerRadius="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Zasób / akcja"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Text="{Binding SelectedPermissionResource}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                    <TextBlock Text="{Binding SelectedPermissionAction}"
                                               Foreground="{DynamicResource MutedForegroundBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="soft-card"
                                Padding="14"
                                CornerRadius="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Nadaj do roli"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <ComboBox ItemsSource="{Binding RolesToAssign}"
                                              SelectedItem="{Binding SelectedRoleToAssign}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1"
                                            Padding="12,10"
                                            Command="{Binding RunPermissionActionCommand}"
                                            CommandParameter="Assign"
                                            IsEnabled="{Binding HasSelectedPermission}"
                                            Background="{DynamicResource AccentSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TextBlock Text="Nadaj"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="soft-card"
                                Padding="14"
                                CornerRadius="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding AssignedRoles.Count, StringFormat='Role z dostępem: {0}'}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <ItemsControl ItemsSource="{Binding AssignedRoles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Padding="10,6"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveRolePermissionCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource SubtleSurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10">
                                                        <TextBlock Text="Odbierz"
                                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="soft-card"
                                Padding="14"
                                CornerRadius="16">
                            <TextBlock Text="{Binding LastActionMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
