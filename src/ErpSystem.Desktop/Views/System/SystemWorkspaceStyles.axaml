<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.soft-card">
        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem Border.table-row">
        <Setter Property="Background" Value="{DynamicResource TableRowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected Border.table-row">
        <Setter Property="Background" Value="{DynamicResource SelectedItemBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SelectedItemBorderBrush}" />
    </Style>
</Styles>
