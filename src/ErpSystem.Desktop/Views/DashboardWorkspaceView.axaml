<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels"
             x:Class="ErpSystem.Desktop.Views.DashboardWorkspaceView"
             x:DataType="vm:DashboardWorkspaceViewModel">
    <StackPanel Spacing="18">
        <Border Padding="18"
                CornerRadius="20"
                Background="{DynamicResource SubtleSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Dashboard"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Padding="14,10">
                    <TextBlock Text="Odśwież dane" />
                </Button>
            </Grid>
        </Border>

        <UniformGrid Columns="4">
            <Border Margin="0,0,12,0"
                    Padding="18"
                    CornerRadius="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Produkty"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Text="{Binding ProductCount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0"
                    Padding="18"
                    CornerRadius="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Dokumenty magazynowe robocze"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Text="{Binding DraftWarehouseDocumentCount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0"
                    Padding="18"
                    CornerRadius="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Zlecenia transportowe"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Text="{Binding TransportOrderCount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
            <Border Padding="18"
                    CornerRadius="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Aktywni pracownicy"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                    <TextBlock Text="{Binding ActiveEmployeeCount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Padding="20"
                CornerRadius="20"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="Szybki start"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding EmptyStateMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
                <WrapPanel ItemWidth="220">
                    <Button Margin="0,0,12,12"
                            Padding="14,12"
                            Command="{Binding OpenWorkspaceCommand}"
                            CommandParameter="/warehouse/goods">
                        <TextBlock Text="Dodaj pierwszy produkt" />
                    </Button>
                    <Button Margin="0,0,12,12"
                            Padding="14,12"
                            Command="{Binding OpenWorkspaceCommand}"
                            CommandParameter="/warehouse/documents">
                        <TextBlock Text="Otwórz dokumenty magazynowe" />
                    </Button>
                    <Button Margin="0,0,12,12"
                            Padding="14,12"
                            Command="{Binding OpenWorkspaceCommand}"
                            CommandParameter="/warehouse/stock">
                        <TextBlock Text="Przejdź do stanów magazynowych" />
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
