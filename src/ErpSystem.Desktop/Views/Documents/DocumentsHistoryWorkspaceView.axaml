<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels"
             xmlns:documents="using:ErpSystem.Desktop.ViewModels.Documents"
             x:Class="ErpSystem.Desktop.Views.Documents.DocumentsHistoryWorkspaceView"
             x:Name="Root"
             x:DataType="documents:DocumentsHistoryWorkspaceViewModel">
    <UserControl.Styles><StyleInclude Source="avares://ErpSystem.Desktop/Views/Documents/DocumentsWorkspaceStyles.axaml" /></UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Spacing="4"><TextBlock Text="Dokumenty" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top"><TextBlock Text="Historia dokumentu ma być czytelna zarówno dla magazynu, HR, jak i finansów." MaxWidth="320" TextWrapping="Wrap" /></Border></Grid>
        <StackPanel Grid.Row="1" Spacing="16"><Border Classes="panel" Padding="14" CornerRadius="18"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel Orientation="Horizontal"><TextBox Width="320" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po numerze, opisie, operatorze..." Padding="12,10" /><ComboBox Width="220" Margin="0,0,10,10" ItemsSource="{Binding ModuleFilterOptions}" SelectedItem="{Binding SelectedModuleFilter}" /><ComboBox Width="220" Margin="0,0,10,10" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" /><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="New"><TextBlock Text="Nowy wpis" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Save"><TextBlock Text="Zapisz" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Delete"><TextBlock Text="Usuń" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Export"><TextBlock Text="Eksportuj" /></Button></WrapPanel></ScrollViewer></Border><ItemsControl ItemsSource="{Binding SummaryCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="245" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SummaryCardViewModel"><Border Margin="0,0,14,14" Padding="16" MinHeight="118" CornerRadius="18" Classes="panel"><StackPanel Spacing="8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" /><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="1.25*,1.0*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Timeline dokumentów" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Jedno miejsce do śledzenia zdarzeń, zmian statusów i decyzji użytkowników." TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding VisibleEntries.Count, StringFormat='Wpisów: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid MinWidth="1000" RowDefinitions="Auto,*"><Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid ColumnDefinitions="110,160,150,120,120,120,100"><TextBlock Text="Moduł" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="1" Text="Typ dokumentu" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="2" Text="Numer" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="3" Text="Zdarzenie" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="5" Text="Operator" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="6" Text="Czas" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid></Border><ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedEntry}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="documents:DocumentHistoryRowViewModel"><Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectEntryCommand, ElementName=Root}" CommandParameter="{Binding}"><Border Margin="0,0,0,8" Padding="12" CornerRadius="14" Classes="table-row" BorderThickness="1"><Grid ColumnDefinitions="110,160,150,120,120,120,100"><TextBlock Text="{Binding Module}" /><TextBlock Grid.Column="1" Text="{Binding DocumentType}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding DocumentNumber}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding EntryType}" /><Border Grid.Column="4" Padding="10,4" CornerRadius="999" Background="{Binding StatusColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border><TextBlock Grid.Column="5" Text="{Binding Actor}" /><TextBlock Grid.Column="6" Text="{Binding OccurredAtLabel}" /></Grid></Border></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></ScrollViewer></Grid></Border>
            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16"><StackPanel Spacing="3"><TextBlock Text="{Binding SelectedRecord.DocumentNumber, FallbackValue='Nowy wpis historii'}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><UniformGrid Columns="2" Rows="3"><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Moduł" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.Module, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Typ dokumentu" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.DocumentType, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Status" Foreground="{DynamicResource MutedForegroundBrush}" /><Border Padding="10,4" CornerRadius="999" Background="{Binding SelectedStatusColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding SelectedRecord.Status, FallbackValue='-'}" Foreground="White" /></Border></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Operator" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.Actor, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Czas" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedOccurredAt}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Opis" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.Description, FallbackValue='-'}" TextWrapping="Wrap" /></StackPanel></UniformGrid><Border Classes="soft-card" Padding="14" CornerRadius="16"><StackPanel Spacing="10"><TextBlock Text="Edycja wpisu" FontSize="16" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Moduł" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorModule}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Typ dokumentu" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDocumentType}" /></StackPanel><StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Numer dokumentu" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDocumentNumber}" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Zdarzenie" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorEntryType}" /></StackPanel><StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="Status" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorStatus}" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="Operator" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorActor}" /></StackPanel></Grid><StackPanel Spacing="4"><TextBlock Text="Opis" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
