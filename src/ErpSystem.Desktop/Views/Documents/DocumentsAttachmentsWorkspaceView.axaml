<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels"
             xmlns:documents="using:ErpSystem.Desktop.ViewModels.Documents"
             x:Class="ErpSystem.Desktop.Views.Documents.DocumentsAttachmentsWorkspaceView"
             x:Name="Root"
             x:DataType="documents:DocumentsAttachmentsWorkspaceViewModel">
    <UserControl.Styles><StyleInclude Source="avares://ErpSystem.Desktop/Views/Documents/DocumentsWorkspaceStyles.axaml" /></UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Spacing="4"><TextBlock Text="Dokumenty" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top"><TextBlock Text="Załączniki są wspólne dla wielu modułów i powinny być łatwe do odszukania." MaxWidth="320" TextWrapping="Wrap" /></Border></Grid>
        <StackPanel Grid.Row="1" Spacing="16"><Border Classes="panel" Padding="14" CornerRadius="18"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel Orientation="Horizontal"><TextBox Width="320" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po pliku, tagu, numerze dokumentu..." Padding="12,10" /><ComboBox Width="220" Margin="0,0,10,10" ItemsSource="{Binding ModuleFilterOptions}" SelectedItem="{Binding SelectedModuleFilter}" /><CheckBox Margin="0,0,14,10" VerticalAlignment="Center" IsChecked="{Binding ShowArchived}" Content="Pokaż archiwum" /><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="New"><TextBlock Text="Nowy" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Save"><TextBlock Text="Zapisz" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Archive"><TextBlock Text="Archiwizuj" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Delete"><TextBlock Text="Usuń" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Export"><TextBlock Text="Eksportuj" /></Button></WrapPanel></ScrollViewer></Border><ItemsControl ItemsSource="{Binding SummaryCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="245" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SummaryCardViewModel"><Border Margin="0,0,14,14" Padding="16" MinHeight="118" CornerRadius="18" Classes="panel"><StackPanel Spacing="8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" /><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="1.25*,1.0*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Rejestr załączników" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Skanowane dokumenty, zdjęcia i pliki techniczne przypięte do procesów ERP." TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding VisibleAttachments.Count, StringFormat='Plików: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid MinWidth="980" RowDefinitions="Auto,*"><Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid ColumnDefinitions="110,150,220,140,90,120,100,110"><TextBlock Text="Moduł" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="1" Text="Dokument" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="2" Text="Plik" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="3" Text="Typ" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="4" Text="Rozmiar" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="5" Text="Operator" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="6" Text="Dodano" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="7" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid></Border><ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleAttachments}" SelectedItem="{Binding SelectedAttachment}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="documents:DocumentAttachmentRowViewModel"><Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectAttachmentCommand, ElementName=Root}" CommandParameter="{Binding}"><Border Margin="0,0,0,8" Padding="12" CornerRadius="14" Classes="table-row" BorderThickness="1"><Grid ColumnDefinitions="110,150,220,140,90,120,100,110"><TextBlock Text="{Binding Module}" /><TextBlock Grid.Column="1" Text="{Binding OwnerDocument}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding ContentType}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="4" Text="{Binding SizeLabel}" /><TextBlock Grid.Column="5" Text="{Binding UploadedBy}" /><TextBlock Grid.Column="6" Text="{Binding UploadedAtLabel}" /><Border Grid.Column="7" Padding="10,4" CornerRadius="999" Background="{Binding StatusColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border></Grid></Border></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></ScrollViewer></Grid></Border>
            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16"><StackPanel Spacing="3"><TextBlock Text="{Binding SelectedRecord.FileName, FallbackValue='Nowy załącznik'}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><UniformGrid Columns="2" Rows="3"><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Moduł" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.Module, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Dokument" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.OwnerDocument, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Typ" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.ContentType, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Rozmiar" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.SizeLabel, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Dodano" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedUploadedAt}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Tryb" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedArchiveLabel}" /></StackPanel></UniformGrid><Border Classes="soft-card" Padding="14" CornerRadius="16"><StackPanel Spacing="10"><TextBlock Text="Edycja załącznika" FontSize="16" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Moduł" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorModule}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Dokument" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorOwnerDocument}" /></StackPanel><StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Plik" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorFileName}" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Typ pliku" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorContentType}" /></StackPanel><StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="Rozmiar" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorSizeLabel}" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="Operator" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorUploadedBy}" /></StackPanel><StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4"><TextBlock Text="Tagi" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorTags}" /></StackPanel></Grid><StackPanel Spacing="4"><TextBlock Text="Opis" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
