<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels"
             xmlns:finance="using:ErpSystem.Desktop.ViewModels.Finance"
             x:Class="ErpSystem.Desktop.Views.Finance.FinanceInvoicesWorkspaceView"
             x:Name="Root"
             x:DataType="finance:FinanceInvoicesWorkspaceViewModel">
    <UserControl.Styles><StyleInclude Source="avares://ErpSystem.Desktop/Views/Finance/FinanceWorkspaceStyles.axaml" /></UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Spacing="4"><TextBlock Text="Finanse" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top"><TextBlock Text="Widok pod sprzedaż, terminy płatności i rozliczenie z transportem." MaxWidth="320" TextWrapping="Wrap" /></Border></Grid>
        <StackPanel Grid.Row="1" Spacing="16"><Border Classes="panel" Padding="14" CornerRadius="18"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel Orientation="Horizontal"><TextBox Width="320" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po numerze, kontrahencie, zleceniu..." Padding="12,10" /><ComboBox Width="220" Margin="0,0,10,10" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" /><ComboBox Width="180" Margin="0,0,10,10" ItemsSource="{Binding CurrencyFilterOptions}" SelectedItem="{Binding SelectedCurrencyFilter}" /><CheckBox Margin="0,0,14,10" VerticalAlignment="Center" IsChecked="{Binding ShowArchived}" Content="Pokaż archiwum" /><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="New"><TextBlock Text="Nowa" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Save"><TextBlock Text="Zapisz" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Archive"><TextBlock Text="Archiwizuj" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Delete"><TextBlock Text="Usuń" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Export"><TextBlock Text="Eksportuj" /></Button></WrapPanel></ScrollViewer></Border><ItemsControl ItemsSource="{Binding SummaryCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="245" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SummaryCardViewModel"><Border Margin="0,0,14,14" Padding="16" MinHeight="118" CornerRadius="18" Classes="panel"><StackPanel Spacing="8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" /><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="1.35*,1.05*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Rejestr faktur" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Dokumenty sprzedażowe z walutą, terminem płatności i outstanding." TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding VisibleInvoices.Count, StringFormat='Faktur: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid MinWidth="1040" RowDefinitions="Auto,*"><Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid ColumnDefinitions="130,160,190,100,100,80,110,120,150"><TextBlock Text="Numer" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="1" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="2" Text="Kontrahent" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="3" Text="Data" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="4" Text="Termin" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="5" Text="Waluta" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="6" Text="Brutto" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="7" Text="Outstanding" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="8" Text="Zlecenie" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid></Border><ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleInvoices}" SelectedItem="{Binding SelectedInvoice}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="finance:FinanceInvoiceRowViewModel"><Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectInvoiceCommand, ElementName=Root}" CommandParameter="{Binding}"><Border Margin="0,0,0,8" Padding="12" CornerRadius="14" Classes="table-row" BorderThickness="1"><Grid ColumnDefinitions="130,160,190,100,100,80,110,120,150"><TextBlock Text="{Binding Number}" FontWeight="SemiBold" /><Border Grid.Column="1" Padding="10,4" CornerRadius="999" Background="{Binding StatusColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border><TextBlock Grid.Column="2" Text="{Binding ContractorName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding InvoiceDateLabel}" /><TextBlock Grid.Column="4" Text="{Binding DueDateLabel}" /><TextBlock Grid.Column="5" Text="{Binding CurrencyCode}" /><TextBlock Grid.Column="6" Text="{Binding GrossAmountLabel}" /><TextBlock Grid.Column="7" Text="{Binding OutstandingLabel}" /><TextBlock Grid.Column="8" Text="{Binding TransportOrderNumber}" TextTrimming="CharacterEllipsis" /></Grid></Border></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></ScrollViewer></Grid></Border>
            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16"><StackPanel Spacing="3"><TextBlock Text="{Binding SelectedRecord.Number, FallbackValue='Nowa faktura'}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><UniformGrid Columns="2" Rows="3"><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Kontrahent" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.ContractorName, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Status" Foreground="{DynamicResource MutedForegroundBrush}" /><Border Padding="10,4" CornerRadius="999" Background="{Binding SelectedStatusColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding SelectedRecord.Status, FallbackValue='-'}" Foreground="White" /></Border></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Brutto" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedGrossLabel}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Outstanding" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedOutstandingLabel}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Termin" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedDueDateLabel}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Zlecenie" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedTransportOrder}" /></StackPanel></UniformGrid><Border Classes="soft-card" Padding="14" CornerRadius="16"><StackPanel Spacing="10"><TextBlock Text="Edycja faktury" FontSize="16" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Numer" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorNumber}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Status" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorStatus}" /></StackPanel><StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Data faktury" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorInvoiceDate}" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Termin" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDueDate}" /></StackPanel><StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="Kontrahent" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorContractorName}" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="Waluta" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorCurrencyCode}" /></StackPanel><StackPanel Grid.Row="3" Spacing="4"><TextBlock Text="Kwota brutto" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorGrossAmount}" /></StackPanel><StackPanel Grid.Row="3" Grid.Column="1" Spacing="4"><TextBlock Text="Outstanding" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorOutstandingAmount}" /></StackPanel></Grid><StackPanel Spacing="4"><TextBlock Text="Powiązane zlecenie" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorTransportOrderNumber}" /></StackPanel><StackPanel Spacing="4"><TextBlock Text="Opis" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
