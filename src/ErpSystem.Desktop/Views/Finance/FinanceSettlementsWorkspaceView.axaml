<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels"
             xmlns:finance="using:ErpSystem.Desktop.ViewModels.Finance"
             xmlns:services="using:ErpSystem.Desktop.Services"
             x:Class="ErpSystem.Desktop.Views.Finance.FinanceSettlementsWorkspaceView"
             x:Name="Root"
             x:DataType="finance:FinanceSettlementsWorkspaceViewModel">
    <UserControl.Styles><StyleInclude Source="avares://ErpSystem.Desktop/Views/Finance/FinanceWorkspaceStyles.axaml" /></UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Spacing="4"><TextBlock Text="Finanse" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top"><TextBlock Text="Rozliczenie musi spinać płatność z właściwym dokumentem bez przekroczenia kwoty." MaxWidth="340" TextWrapping="Wrap" /></Border></Grid>
        <StackPanel Grid.Row="1" Spacing="16"><Border Classes="panel" Padding="14" CornerRadius="18"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel Orientation="Horizontal"><TextBox Width="320" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po płatności, numerze dokumentu..." Padding="12,10" /><ComboBox Width="220" Margin="0,0,10,10" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" /><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="New"><TextBlock Text="Nowe" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Save"><TextBlock Text="Zapisz" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Delete"><TextBlock Text="Usuń" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Export"><TextBlock Text="Eksportuj" /></Button></WrapPanel></ScrollViewer></Border><ItemsControl ItemsSource="{Binding SummaryCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="245" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SummaryCardViewModel"><Border Margin="0,0,14,14" Padding="16" MinHeight="118" CornerRadius="18" Classes="panel"><StackPanel Spacing="8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" /><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="1.35*,1.05*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Lista rozliczeń" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Powiązania płatności z fakturami i kosztami w jednym widoku kontrolnym." TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding VisibleSettlements.Count, StringFormat='Rozliczeń: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid MinWidth="930" RowDefinitions="Auto,*"><Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid ColumnDefinitions="150,150,110,110,150,130"><TextBlock Text="Płatność" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="1" Text="Dokument" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="2" Text="Typ" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="3" Text="Kwota" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="5" Text="Data" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid></Border><ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleSettlements}" SelectedItem="{Binding SelectedSettlement}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="finance:FinanceSettlementRowViewModel"><Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectSettlementCommand, ElementName=Root}" CommandParameter="{Binding}"><Border Margin="0,0,0,8" Padding="12" CornerRadius="14" Classes="table-row" BorderThickness="1"><Grid ColumnDefinitions="150,150,110,110,150,130"><TextBlock Text="{Binding PaymentReference}" /><TextBlock Grid.Column="1" Text="{Binding TargetDocumentNumber}" /><TextBlock Grid.Column="2" Text="{Binding TargetDocumentType}" /><TextBlock Grid.Column="3" Text="{Binding AmountLabel}" /><Border Grid.Column="4" Padding="10,4" CornerRadius="999" Background="{Binding StatusColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border><TextBlock Grid.Column="5" Text="{Binding SettledAtLabel}" /></Grid></Border></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></ScrollViewer></Grid></Border>
            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16"><StackPanel Spacing="3"><TextBlock Text="{Binding SelectedRecord.TargetDocumentNumber, FallbackValue='Nowe rozliczenie'}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><UniformGrid Columns="2" Rows="2"><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Płatność" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.PaymentReference, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Status" Foreground="{DynamicResource MutedForegroundBrush}" /><Border Padding="10,4" CornerRadius="999" Background="{Binding SelectedStatusColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding SelectedRecord.Status, FallbackValue='-'}" Foreground="White" /></Border></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Kwota" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.Amount, StringFormat='{}{0:N2}'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Data" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedSettledAtLabel}" /></StackPanel></UniformGrid><Border Classes="soft-card" Padding="14" CornerRadius="16"><StackPanel Spacing="10"><TextBlock Text="Edycja rozliczenia" FontSize="16" FontWeight="SemiBold" /><StackPanel Spacing="4"><TextBlock Text="Płatność źródłowa" Foreground="{DynamicResource MutedForegroundBrush}" /><ComboBox ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding SelectedPaymentOption}"><ComboBox.ItemTemplate><DataTemplate x:DataType="services:FinancePaymentRecord"><TextBlock Text="{Binding ReferenceNumber}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Referencja płatności" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorPaymentReference}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Typ dokumentu" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorTargetDocumentType}" /></StackPanel><StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Numer dokumentu" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorTargetDocumentNumber}" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Kwota" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorAmount}" /></StackPanel><StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="Status" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorStatus}" /></StackPanel></Grid><StackPanel Spacing="4"><TextBlock Text="Notatka" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
