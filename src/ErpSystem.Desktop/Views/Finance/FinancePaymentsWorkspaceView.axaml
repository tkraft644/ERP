<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels"
             xmlns:finance="using:ErpSystem.Desktop.ViewModels.Finance"
             x:Class="ErpSystem.Desktop.Views.Finance.FinancePaymentsWorkspaceView"
             x:Name="Root"
             x:DataType="finance:FinancePaymentsWorkspaceViewModel">
    <UserControl.Styles><StyleInclude Source="avares://ErpSystem.Desktop/Views/Finance/FinanceWorkspaceStyles.axaml" /></UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Spacing="4"><TextBlock Text="Finanse" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top"><TextBlock Text="Płatności spinają koszty, faktury i rozliczenia w jednym widoku." MaxWidth="320" TextWrapping="Wrap" /></Border></Grid>
        <StackPanel Grid.Row="1" Spacing="16"><Border Classes="panel" Padding="14" CornerRadius="18"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel Orientation="Horizontal"><TextBox Width="320" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po referencji, kontrahencie, metodzie..." Padding="12,10" /><ComboBox Width="200" Margin="0,0,10,10" ItemsSource="{Binding DirectionFilterOptions}" SelectedItem="{Binding SelectedDirectionFilter}" /><ComboBox Width="180" Margin="0,0,10,10" ItemsSource="{Binding CurrencyFilterOptions}" SelectedItem="{Binding SelectedCurrencyFilter}" /><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="New"><TextBlock Text="Nowa" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Save"><TextBlock Text="Zapisz" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Delete"><TextBlock Text="Usuń" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Export"><TextBlock Text="Eksportuj" /></Button></WrapPanel></ScrollViewer></Border><ItemsControl ItemsSource="{Binding SummaryCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="245" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SummaryCardViewModel"><Border Margin="0,0,14,14" Padding="16" MinHeight="118" CornerRadius="18" Classes="panel"><StackPanel Spacing="8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" /><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="1.35*,1.05*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Rejestr płatności" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Wpływy i wypływy z kontrolą kwot rozliczonych i pozostałych." TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding VisiblePayments.Count, StringFormat='Płatności: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid MinWidth="1060" RowDefinitions="Auto,*"><Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid ColumnDefinitions="100,110,180,80,110,110,110,120,130"><TextBlock Text="Data" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="1" Text="Kierunek" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="2" Text="Kontrahent" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="3" Text="Waluta" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="4" Text="Kwota" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="5" Text="Rozliczono" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="6" Text="Pozostało" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="7" Text="Metoda" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="8" Text="Referencja" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid></Border><ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisiblePayments}" SelectedItem="{Binding SelectedPayment}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="finance:FinancePaymentRowViewModel"><Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectPaymentCommand, ElementName=Root}" CommandParameter="{Binding}"><Border Margin="0,0,0,8" Padding="12" CornerRadius="14" Classes="table-row" BorderThickness="1"><Grid ColumnDefinitions="100,110,180,80,110,110,110,120,130"><TextBlock Text="{Binding PaymentDateLabel}" /><Border Grid.Column="1" Padding="10,4" CornerRadius="999" Background="{Binding DirectionColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding Direction}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border><TextBlock Grid.Column="2" Text="{Binding ContractorName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding CurrencyCode}" /><TextBlock Grid.Column="4" Text="{Binding AmountLabel}" /><TextBlock Grid.Column="5" Text="{Binding SettledAmountLabel}" /><TextBlock Grid.Column="6" Text="{Binding RemainingAmountLabel}" /><TextBlock Grid.Column="7" Text="{Binding Method}" /><TextBlock Grid.Column="8" Text="{Binding ReferenceNumber}" TextTrimming="CharacterEllipsis" /></Grid></Border></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></ScrollViewer></Grid></Border>
            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16"><StackPanel Spacing="3"><TextBlock Text="{Binding SelectedRecord.ReferenceNumber, FallbackValue='Nowa płatność'}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><UniformGrid Columns="2" Rows="3"><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Kierunek" Foreground="{DynamicResource MutedForegroundBrush}" /><Border Padding="10,4" CornerRadius="999" Background="{Binding SelectedDirectionColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding SelectedRecord.Direction, FallbackValue='-'}" Foreground="White" /></Border></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Kontrahent" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.ContractorName, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Kwota" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedAmountLabel}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Rozliczono" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedSettledLabel}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Pozostało" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRemainingLabel}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Metoda" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.Method, FallbackValue='-'}" /></StackPanel></UniformGrid><Border Classes="soft-card" Padding="14" CornerRadius="16"><StackPanel Spacing="10"><TextBlock Text="Edycja płatności" FontSize="16" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Data" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorPaymentDate}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Kierunek" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorDirection}" /></StackPanel><StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Kontrahent" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorContractorName}" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Waluta" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorCurrencyCode}" /></StackPanel><StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="Kwota" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorAmount}" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="Rozliczono" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorSettledAmount}" /></StackPanel><StackPanel Grid.Row="3" Spacing="4"><TextBlock Text="Metoda" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorMethod}" /></StackPanel><StackPanel Grid.Row="3" Grid.Column="1" Spacing="4"><TextBlock Text="Referencja" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorReferenceNumber}" /></StackPanel></Grid><StackPanel Spacing="4"><TextBlock Text="Notatka" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
