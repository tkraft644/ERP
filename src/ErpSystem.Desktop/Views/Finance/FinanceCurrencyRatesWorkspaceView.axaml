<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels"
             xmlns:finance="using:ErpSystem.Desktop.ViewModels.Finance"
             x:Class="ErpSystem.Desktop.Views.Finance.FinanceCurrencyRatesWorkspaceView"
             x:Name="Root"
             x:DataType="finance:FinanceCurrencyRatesWorkspaceViewModel">
    <UserControl.Styles><StyleInclude Source="avares://ErpSystem.Desktop/Views/Finance/FinanceWorkspaceStyles.axaml" /></UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Spacing="4"><TextBlock Text="Finanse" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><Border Grid.Column="1" Padding="12,9" CornerRadius="14" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Top"><TextBlock Text="Kursy wykorzystywane przez faktury, koszty i transport zagraniczny." MaxWidth="320" TextWrapping="Wrap" /></Border></Grid>
        <StackPanel Grid.Row="1" Spacing="16"><Border Classes="panel" Padding="14" CornerRadius="18"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel Orientation="Horizontal"><TextBox Width="320" Margin="0,0,10,10" Text="{Binding SearchText}" Watermark="Szukaj po parze, źródle..." Padding="12,10" /><ComboBox Width="220" Margin="0,0,10,10" ItemsSource="{Binding SourceFilterOptions}" SelectedItem="{Binding SelectedSourceFilter}" /><CheckBox Margin="0,0,14,10" VerticalAlignment="Center" IsChecked="{Binding ShowArchived}" Content="Pokaż archiwum" /><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="New"><TextBlock Text="Nowy" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Save"><TextBlock Text="Zapisz" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Archive"><TextBlock Text="Archiwizuj" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Delete"><TextBlock Text="Usuń" /></Button><Button Margin="0,0,10,10" Padding="12,10" Command="{Binding RunActionCommand}" CommandParameter="Export"><TextBlock Text="Eksportuj" /></Button></WrapPanel></ScrollViewer></Border><ItemsControl ItemsSource="{Binding SummaryCards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="245" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SummaryCardViewModel"><Border Margin="0,0,14,14" Padding="16" MinHeight="118" CornerRadius="18" Classes="panel"><StackPanel Spacing="8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding AccentColor}" /><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="1.2*,1.0*" ColumnSpacing="18">
            <Border Classes="panel" Padding="18" CornerRadius="22"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Tabela kursów" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Kursy aktywne i historyczne z podziałem na źródło i parę walutową." TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding VisibleRates.Count, StringFormat='Pozycji: {0}'}" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid MinWidth="760" RowDefinitions="Auto,*"><Border Padding="12,10" CornerRadius="14" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid ColumnDefinitions="120,90,90,120,140,120"><TextBlock Text="Data" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="1" Text="Base" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="2" Text="Quote" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="3" Text="Kurs" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="4" Text="Źródło" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" /></Grid></Border><ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding VisibleRates}" SelectedItem="{Binding SelectedRate}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="finance:FinanceCurrencyRateRowViewModel"><Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectRateCommand, ElementName=Root}" CommandParameter="{Binding}"><Border Margin="0,0,0,8" Padding="12" CornerRadius="14" Classes="table-row" BorderThickness="1"><Grid ColumnDefinitions="120,90,90,120,140,120"><TextBlock Text="{Binding RateDateLabel}" /><TextBlock Grid.Column="1" Text="{Binding BaseCurrency}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding QuoteCurrency}" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="{Binding RateLabel}" /><TextBlock Grid.Column="4" Text="{Binding Source}" /><Border Grid.Column="5" Padding="10,4" CornerRadius="999" Background="{Binding StatusColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" /></Border></Grid></Border></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></ScrollViewer></Grid></Border>
            <Border Grid.Column="1" Classes="panel" Padding="18" CornerRadius="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16"><StackPanel Spacing="3"><TextBlock Text="{Binding SelectedPair}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding LastActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}" /></StackPanel><UniformGrid Columns="2" Rows="2"><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Kurs" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRateLabel}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Źródło" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.Source, FallbackValue='-'}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Tryb" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedArchiveLabel}" /></StackPanel><StackPanel Margin="0,0,12,10" Spacing="4"><TextBlock Text="Notatka" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBlock Text="{Binding SelectedRecord.Notes, FallbackValue='-'}" TextWrapping="Wrap" /></StackPanel></UniformGrid><Border Classes="soft-card" Padding="14" CornerRadius="16"><StackPanel Spacing="10"><TextBlock Text="Edycja kursu" FontSize="16" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10"><StackPanel Spacing="4"><TextBlock Text="Data" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorRateDate}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Źródło" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorSource}" /></StackPanel><StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="Base" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorBaseCurrency}" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="Quote" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorQuoteCurrency}" /></StackPanel><StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="Kurs" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorRate}" /></StackPanel></Grid><StackPanel Spacing="4"><TextBlock Text="Notatka" Foreground="{DynamicResource MutedForegroundBrush}" /><TextBox Text="{Binding EditorNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
