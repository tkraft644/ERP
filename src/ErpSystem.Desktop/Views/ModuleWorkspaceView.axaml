<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErpSystem.Desktop.ViewModels"
             x:Class="ErpSystem.Desktop.Views.ModuleWorkspaceView"
             x:DataType="vm:ModuleWorkspaceViewModelBase">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding ModuleTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{Binding AccentColor}" />
                <TextBlock Text="{Binding WorkspaceTitle}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Description}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,8"
                    CornerRadius="14"
                    Background="{Binding AccentSurfaceColor}"
                    BorderBrush="{Binding AccentColor}"
                    BorderThickness="1">
                <TextBlock Text="{Binding BadgeText}"
                           FontWeight="SemiBold"
                           Foreground="{Binding AccentColor}" />
            </Border>
        </Grid>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Metrics}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               ItemWidth="280"
                               ItemHeight="112" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkspaceMetricViewModel">
                    <Border Margin="0,0,16,16"
                            Padding="18"
                            CornerRadius="20"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Label}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBlock Text="{Binding Value}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AccentColor}" />
                            <TextBlock Text="{Binding Hint}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2"
              ColumnDefinitions="1.15*,0.85*"
              ColumnSpacing="18">
            <Border Padding="20"
                    CornerRadius="22"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Co jest pod reka"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />

                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceActionViewModel">
                                <Border Margin="0,0,0,10"
                                        Padding="16,14"
                                        CornerRadius="18"
                                        Background="{Binding Background}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground}" />
                                        <TextBlock Text="{Binding Caption}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="20"
                    CornerRadius="22"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Na co zwrocic uwage"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />

                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceActivityViewModel">
                                <Border Margin="0,0,0,10"
                                        Padding="16,14"
                                        CornerRadius="18"
                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                        <Border Grid.Column="1"
                                                Padding="10,5"
                                                CornerRadius="12"
                                                Background="{Binding StateColor}">
                                            <TextBlock Text="{Binding State}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,8,0,0"
                                                   Text="{Binding Detail}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
